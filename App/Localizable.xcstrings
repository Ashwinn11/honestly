    "What thought keeps coming back that you haven't said out loud yet?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما هي الفكرة التي تستمر في العودة ولم تقلها بصوت عالٍ حتى الآن ؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcher Gedanke kommt immer wieder, den du noch nicht laut ausgesprochen hast?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué pensamiento sigue regresando que aún no hayas dicho en voz alta?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle pensée revient sans cesse que vous n'avez pas encore dite à haute voix ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale pensiero continua a tornare che non hai ancora detto ad alta voce?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたがまだ声に出していない考えは何ですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 큰 소리로 말하지 않았는데 어떤 생각이 계속 떠오르시나요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welke gedachte blijft terugkomen die je nog niet hardop hebt gezegd?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Que pensamento continua a voltar que você ainda não disse em voz alta?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какая мысль продолжает возвращаться, о которой вы еще не сказали вслух?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "什么想法不断回来，你还没有大声说出来？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你還沒有大聲說出來的想法是什麼？"
          }
        }
      }
    },
    "What used to light you up that you've lost touch with lately?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما الذي اعتدت على إضاءته وفقدت الاتصال به مؤخرًا ؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was hat dich früher beleuchtet, mit dem du in letzter Zeit den Kontakt verloren hast?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué te iluminaba y con qué has perdido el contacto últimamente?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qui vous éclairait et avec quoi vous avez perdu le contact ces derniers temps ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa ti illuminava con cui hai perso i contatti ultimamente?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近連絡が取れなくなったものは何でしたか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근에 연락이 끊겼던 불을 밝히기 위해 사용한 것은 무엇인가요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat verlichtte je vroeger waar je de laatste tijd geen contact meer mee hebt?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que costumava iluminá-lo com o qual você perdeu o contato ultimamente?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что зажгло в тебе то, с чем ты в последнее время потерял связь?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "什么曾经照亮了你，你最近失去了联系？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "曾經有哪些東西照亮了你，而你最近失去了聯繫？"
          }
        }
      }
    },
    "What version of yourself showed up yesterday — and is that who you want to be today?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما هي نسختك التي ظهرت بالأمس — وهل هذا ما تريد أن تكون عليه اليوم ؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Version von dir ist gestern aufgetaucht — und willst du das heute sein?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué versión de ti mismo apareció ayer, y es quien quieres ser hoy?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle version de vous-même est apparue hier — et est-ce que c'est ce que vous voulez être aujourd'hui ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale versione di te stesso è apparsa ieri — ed è quella che vuoi essere oggi?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "昨日、どのバージョンの自分が現れましたか？そして、それはあなたが今日なりたい人ですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어제 어떤 모습으로 나타났으며, 오늘 당신이 되고 싶은 사람입니까?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welke versie van jezelf verscheen gisteren — en is dat wie je vandaag wilt zijn?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Que versão de si mesmo apareceu ontem — e é isso que você quer ser hoje?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какая версия вас появилась вчера — и кем вы хотите быть сегодня?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "昨天出现的自己是什么样的？今天你想成为什么样的人？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "昨天出現的自己是什麼樣的？今天你想成為什麼樣的人？"
          }
        }
      }
    },
    "What we don't do": {
      "extractionState": "manual",
