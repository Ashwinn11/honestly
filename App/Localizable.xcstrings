    "You return to calm, no matter how far you’ve wandered.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You return to calm, no matter how far you’ve wandered."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعود إلى الهدوء، بغض النظر عن المسافة التي تجولت فيها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie kehren zur Ruhe zurück, egal wie weit Sie gewandert sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelves a la calma, por mucho que te hayas desviado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous revenez au calme, peu importe la distance parcourue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritorni alla calma, non importa quanto lontano hai vagato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どんなに遠くまでさまよっていても、あなたは平静に戻ります。"
