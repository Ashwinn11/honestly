    "You pause to honor all that you have and all that you are.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You pause to honor all that you have and all that you are."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتوقف لتكريم كل ما لديك وكل ما أنت عليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hältst inne, um alles zu ehren, was du hast und was du bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haces una pausa para honrar todo lo que tienes y todo lo que eres."
          }
        },
        "fr": {
