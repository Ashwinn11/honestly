    "You are worthy of being seen, heard, and respected.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are worthy of being seen, heard, and respected."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت تستحق أن تُرى، وتُسمع، وتُحترم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie sind es wert, gesehen, gehört und respektiert zu werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres digno de ser visto, escuchado y respetado."
