    "Each breath you take is a gift you cherish." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل نفس تأخذه هو هدية تعتز بها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Atemzug, den Sie machen, ist ein Geschenk, das Sie schätzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each breath you take is a gift you cherish."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada respiro que tomas es un regalo que aprecias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque respiration que vous prenez est un cadeau que vous chérissez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni respiro che fai è un dono che custodisci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたが吸うそれぞれの呼吸は、あなたにとって大切な贈り物です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신이 내쉬는 호흡 하나하나는 당신이 소중히 여기는 선물입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke ademhaling die je neemt is een geschenk dat je koestert."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada respiração que você respira é um presente que você valoriza."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый ваш вдох — это подарок, которым вы дорожите."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的每一次呼吸都是你珍惜的礼物。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的每一次呼吸都是你珍惜的禮物。"
          }
        }
      }
    },
    "Each day brings you closer to your greatest goals." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل يوم يجعلك أقرب إلى أعظم أهدافك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Tag bringt Sie Ihren größten Zielen näher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each day brings you closer to your greatest goals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada día te acerca a tus mayores objetivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each day brings you closer to your greatest goals."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni giorno ti avvicina ai tuoi obiettivi più grandi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎日があなたを最大の目標に近づけます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매일 당신은 가장 큰 목표에 더 가까워집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke dag brengt je dichter bij je grootste doelen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada dia o aproxima de seus maiores objetivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый день приближает вас к вашим величайшим целям."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一天都让您更接近您的最大目标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一天都讓您更接近您的最大目標。"
          }
        }
      }
    },
    "Each day, I encounter good people and am grateful." : {
      "comment" : "Affirmation library quote. Keep it personal, gentle, and natural in the translated language.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل يوم، أقابل أشخاصًا طيبين وأنا ممتن لهم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden Tag begegne ich guten Menschen und bin dankbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada día encuentro buena gente y estoy agradecido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque jour, je rencontre de bonnes personnes et je leur en suis reconnaissant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni giorno incontro brave persone e ne sono grato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "良い人たちに出会えて感謝の毎日です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매일 좋은 사람들을 만나 감사하게 지내고 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke dag ontmoet ik goede mensen en ben dankbaar."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os dias encontro pessoas boas e sou grato."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый день я встречаю хороших людей и благодарен им."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天都会遇到好人，感恩。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天都會遇到好人，感恩。"
          }
        }
      }
    },
    "Each moment of gratitude invites more peace into your life." : {
