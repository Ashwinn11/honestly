        }
      }
    },
    "You are bold enough to try, strong enough to grow.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are bold enough to try, strong enough to grow."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت جريء بما يكفي للمحاولة، وقوي بما يكفي لتنمو."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist mutig genug, es zu versuchen, stark genug, um zu wachsen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres lo suficientemente audaz para intentarlo, lo suficientemente fuerte para crecer."
