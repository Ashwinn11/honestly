    "Longest yet — keep the sun rising." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أطول مدة حتى الآن — دع الشمس تشرق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bisher am längsten — lass die Sonne aufgehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu récord — que siga saliendo el sol."
          }
        },
