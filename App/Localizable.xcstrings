    "Made from your month: its newest photo, or the page theme you used most." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مصنوع من شهرك: أحدث صورة فيه، أو سمة الصفحة التي استخدمتها أكثر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus deinem Monat gemacht: sein neuestes Foto oder das Seitendesign, das du am häufigsten genutzt hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hecha con tu mes: su foto más reciente o el tema de página que más usaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créée à partir de ton mois : sa photo la plus récente, ou le thème de page que tu as le plus utilisé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creata dal tuo mese: la sua foto più recente o il tema di pagina che hai usato di più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その月から作られます：いちばん新しい写真、またはいちばん使ったページテーマ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그달로 만들어져요. 가장 최근 사진이나 가장 많이 쓴 페이지 테마로요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemaakt van je maand: de nieuwste foto, of het paginathema dat je het vaakst gebruikte."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feita a partir do seu mês: a foto mais recente ou o tema de página que você mais usou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создаётся из вашего месяца: его последнее фото или тема страницы, которую вы использовали чаще всего."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由这个月生成：最新的一张照片，或你最常用的页面主题。"
