    "My worth does not depend on what others think of me." : {
      "comment" : "Affirmation library quote. Keep it personal, gentle, and natural in the translated language.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قيمتي لا تعتمد على ما يعتقده الآخرون عني."
          }
        },
