    "My worth isn't measured by what I get done.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قيمتي لا تُقاس بما أنجزه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mein Wert hängt nicht davon ab, was ich schaffe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi valor no se mide por lo que logro hacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma valeur ne se mesure pas à ce que j'accomplis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il mio valore non si misura da quello che riesco a fare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私の価値は、どれだけこなしたかでは決まらない。"
