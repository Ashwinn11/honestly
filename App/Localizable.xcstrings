    "I accept all my experiences and draw value from them." : {
      "comment" : "Affirmation library quote. Keep it personal, gentle, and natural in the translated language.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أتقبل جميع تجاربي وأستمد منها القيمة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich akzeptiere alle meine Erfahrungen und schöpfe Wert daraus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acepto todas mis experiencias y saco valor de ellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J'accepte toutes mes expériences et j'en tire de la valeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accetto tutte le mie esperienze e ne traggo valore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私は自分のすべての経験を受け入れ、そこから価値を引き出します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나는 나의 모든 경험을 받아들이고 그로부터 가치를 얻습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik accepteer al mijn ervaringen en haal er waarde uit."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceito todas as minhas experiências e tiro valor delas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я принимаю весь свой опыт и извлекаю из него пользу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我接受我所有的经历并从中汲取价值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我接受我所有的經驗並從中汲取價值。"
          }
        }
      }
    },
    "I accept and love my body just the way it is." : {
