    "Add words to My affirmations. Your reader, widgets and reminders use that collection.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف كلمات إلى «عباراتي الإيجابية». تظهر المجموعة نفسها في شاشة القراءة والويدجت والتذكيرات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Worte zu „Meine Affirmationen“ hinzu. Lesebereich, Widgets und Erinnerungen verwenden diese Sammlung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade palabras a Mis afirmaciones. La lectura, los widgets y los recordatorios usan esa colección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des mots à Mes affirmations. La lecture, les widgets et les rappels utilisent cette collection."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi parole a Le mie affermazioni. La lettura, i widget e i promemoria usano questa raccolta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の肯定の言葉に追加しましょう。読む画面、ウィジェット、リマインダーにはこのコレクションを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나의 확언에 말을 추가하세요. 읽기 화면, 위젯, 알림에 같은 모음을 사용해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg woorden toe aan Mijn affirmaties. Het leesscherm, de widgets en herinneringen gebruiken die verzameling."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona palavras a As minhas afirmações. A leitura, os widgets e os lembretes usam essa coleção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляйте слова в «Мои аффирмации». Этот набор используется для чтения, в виджетах и напоминаниях."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将话语添加到“我的肯定语”。阅读界面、小组件和提醒都会使用这个合集。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將話語加入「我的肯定語」。閱讀畫面、小工具和提醒都會使用這個合集。"
          }
        }
      }
    },
