        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 당신이 가진 모든 것과 당신 자신인 모든 것을 존중하기 위해 잠시 멈춥니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je pauzeert om alles te eren wat je hebt en alles wat je bent."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você faz uma pausa para honrar tudo o que você tem e tudo o que você é."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы делаете паузу, чтобы почтить все, что у вас есть, и все, чем вы являетесь."
