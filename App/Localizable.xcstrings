    "What are you avoiding, and what does that avoidance cost you?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما الذي تتجنبه، وما الذي يكلفك هذا التجنب ؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was vermeiden Sie und was kostet Sie diese Vermeidung?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué estás evitando y cuánto te cuesta evitarlo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce que vous évitez et que vous coûte cet évitement ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa stai evitando e quanto ti costa evitarlo?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは何を避けていますか、そしてその回避はあなたにどのような費用がかかりますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피하고 있는 것은 무엇이며, 그 피하는 데 드는 비용은 얼마입니까?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat vermijd je en wat kost die vermijding je?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você está evitando e o que isso lhe custa?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чего вы избегаете, и чего вам это стоит?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您在回避什么，这种回避会给您带来什么代价？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您在避免什麼，這種避免會讓您付出什麼代價？"
          }
        }
      }
    },
    "What are you carrying from yesterday that you'd like to set down?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما الذي تحمله من الأمس وترغب في وضعه ؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was trägst du von gestern bei dir, das du absetzen möchtest?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué llevas de ayer que te gustaría dejar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce que vous transportez d'hier que vous aimeriez mettre en place ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa porti con te di ieri che vorresti mettere giù?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "昨日から持ち歩いているもので、何を置きたいと思っていますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어제부터 무엇을 들고 내려오시겠습니까?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat draag je mee van gisteren dat je zou willen neerzetten?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você carrega de ontem que gostaria de pousar?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что вы несете со вчерашнего дня, что вы хотели бы установить?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您昨天带了什么想要放下的东西？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你昨天帶了什麼想放下的東西？"
          }
        }
      }
    },
    "What are you pretending not to think about?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما الذي تتظاهر بعدم التفكير فيه ؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Worüber tust du so, als würdest du nicht nachdenken?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿En qué pretendes no pensar?"
          }
        },
        "fr": {
          "stringUnit": {
