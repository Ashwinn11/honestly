        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je keert terug naar de rust, ongeacht hoe ver je bent afgedwaald."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você volta à calma, não importa o quão longe você tenha vagado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы возвращаетесь к спокойствию, независимо от того, как далеко вы забрели."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
