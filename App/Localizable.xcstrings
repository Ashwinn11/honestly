    "You are calm even in unfamiliar places.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are calm even in unfamiliar places."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت هادئ حتى في الأماكن غير المألوفة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selbst an unbekannten Orten bleiben Sie ruhig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás tranquilo incluso en lugares desconocidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes calme même dans des endroits inconnus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei calmo anche in luoghi sconosciuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "慣れない場所でも落ち着いていますね。"
