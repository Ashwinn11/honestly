        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You deserve joy, peace, and self-acceptance."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت تستحق الفرح والسلام وقبول الذات."
