    "Choose whether Honestly\ncan notify you.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ما إذا كان بإمكان Honestly\nإرسال إشعارات إليك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entscheide, ob Honestly\ndir Mitteilungen senden darf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige si Honestly\npuede enviarte notificaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez si Honestly\npeut vous envoyer des notifications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli se Honestly\npuò inviarti notifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Honestlyからの通知を\n受け取るか選びましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Honestly 알림을\n받을지 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies of Honestly je\nmeldingen mag sturen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe se o Honestly\nte pode enviar notificações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, может ли Honestly\nприсылать вам уведомления."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择是否允许 Honestly\n向你发送通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇是否允許 Honestly\n傳送通知給你。"
          }
        }
      }
    },
    "A little space to\nhear yourself.": {
