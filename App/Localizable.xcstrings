    "Allow Screen Time access, then choose the apps you want to hold.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول إلى مدة استخدام الجهاز، ثم اختر التطبيقات التي تريد إيقافها مؤقتًا."
          }
        },
        "de": {
          "stringUnit": {
