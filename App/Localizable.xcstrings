    },
    "You rise stronger with every challenge you face.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You rise stronger with every challenge you face."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت ترتفع بشكل أقوى مع كل تحدٍ تواجهه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit jeder Herausforderung, der Sie sich stellen, werden Sie stärker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te vuelves más fuerte con cada desafío que enfrentas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous devenez plus fort à chaque défi auquel vous faites face."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti alzi più forte con ogni sfida che affronti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "困難に直面するたびに、あなたはより強くなっていきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 직면할 때마다 더욱 강해집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je wordt sterker met elke uitdaging die je tegenkomt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você fica mais forte a cada desafio que enfrenta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы становитесь сильнее с каждым испытанием, с которым сталкиваетесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面对每一次挑战，你都会变得更加坚强。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "面對每一次挑戰，你都會變得更堅強。"
          }
        }
      }
    },
    "You rest in the present moment and let it hold you.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You rest in the present moment and let it hold you."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت تستريح في اللحظة الحالية وتدعها تمسك بك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du ruhst im gegenwärtigen Moment und lässt dich von ihm halten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descansas en el momento presente y dejas que te abrace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous vous reposez dans le moment présent et laissez-le vous retenir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riposi nel momento presente e lasci che ti trattenga."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは今この瞬間に休んで、その瞬間につかまってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 현재 순간에 휴식을 취하고 그것이 당신을 붙잡도록 놔두세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je rust uit in het huidige moment en laat het je vasthouden."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você descansa no momento presente e deixa-o te abraçar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы отдыхаете в настоящем моменте и позволяете ему удерживать вас."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你安息在当下，让它抓住你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你安息在當下，讓它抓住你。"
          }
        }
      }
    },
    "You rise above self-doubt and keep moving forward.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You rise above self-doubt and keep moving forward."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت ترتفع فوق الشك الذاتي وتستمر في المضي قدمًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie überwinden Selbstzweifel und machen weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te elevas por encima de las dudas y sigues avanzando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous dépassez le doute et continuez à avancer."
