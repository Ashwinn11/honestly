        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual obrigação hoje é real e quais você inventou?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какие обязательства сегодня реальны, и какие из них вы взяли на себя?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天什么是真正的义务，你编造了哪些义务？"
