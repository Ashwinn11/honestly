    "Gratitude brings joy and light into your life." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الامتنان يجلب الفرح والنور إلى حياتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dankbarkeit bringt Freude und Licht in Ihr Leben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratitude brings joy and light into your life."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La gratitud trae alegría y luz a tu vida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La gratitude apporte de la joie et de la lumière dans votre vie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La gratitudine porta gioia e luce nella tua vita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感謝はあなたの人生に喜びと光をもたらします。"
