            "value": "Qué permanece en tu dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui reste sur ton appareil"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa resta sul tuo dispositivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末に残るもの"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에 남는 것"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat op je apparaat blijft"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que fica no seu dispositivo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
