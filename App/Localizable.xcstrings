          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조용히 기대되는 것은 무엇입니까?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waar kijken jullie naar uit?"
          }
        },
        "pt": {
          "stringUnit": {
