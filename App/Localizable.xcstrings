        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent helend en dat maakt je sterk."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está se curando e isso o torna forte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы исцеляетесь, и это делает вас сильными."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你正在康复，这让你变得坚强。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你正在康復，這讓你變得堅強。"
          }
        }
      }
    },
