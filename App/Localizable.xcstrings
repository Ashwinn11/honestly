        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik aanvaard de verantwoordelijkheid voor wat van mij is en laat los wat niet van mij is."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceito a responsabilidade pelo que é meu e libero o que não é."
