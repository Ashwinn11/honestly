    "You recognize the beauty in yourself and others.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You recognize the beauty in yourself and others."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت تتعرف على الجمال في نفسك وفي الآخرين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie erkennen die Schönheit in sich selbst und anderen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconoces la belleza en ti mismo y en los demás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous reconnaissez la beauté de vous-même et des autres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconosci la bellezza in te stesso e negli altri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは自分自身と他人の美しさを認識します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 자신과 다른 사람의 아름다움을 인식합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je herkent de schoonheid in jezelf en anderen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você reconhece a beleza em si mesmo e nos outros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы признаете красоту в себе и других."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您认识到自己和他人的美丽。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您認識到自己和他人的美麗。"
          }
        }
      }
    },
