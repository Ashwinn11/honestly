            "state" : "translated",
            "value" : "Your passion drives you toward greatness."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua passione ti spinge verso la grandezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの情熱があなたを偉大な方向へと駆り立てます。"
          }
        },
        "ko" : {
          "stringUnit" : {
