    "What's one small thing you did yesterday that deserves a quiet nod?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما هو الشيء الصغير الذي فعلته بالأمس والذي يستحق إيماءة هادئة ؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ist eine Kleinigkeit, die du gestern getan hast und die ein leises Nicken verdient?"
