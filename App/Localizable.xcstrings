    "You are not rushed; everything unfolds in time." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت لا تتعجل. كل شيء يتكشف في الوقت المناسب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie sind nicht in Eile; alles entfaltet sich mit der Zeit."
