          "stringUnit": {
            "state": "translated",
            "value": "You surrender to stillness and let it nourish you."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت تستسلم للسكون وتتركه يغذيك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du gibst dich der Stille hin und lässt dich von ihr nähren."
          }
