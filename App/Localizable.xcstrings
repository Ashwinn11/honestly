      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أستطيع أن أتساءل عن خوفي دون أن أتساءل عن قيمتي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich kann meine Angst hinterfragen, ohne meinen Wert in Frage zu stellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedo cuestionar mi miedo sin cuestionar mi valor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je peux remettre en question ma peur sans remettre en question ma valeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posso mettere in discussione la mia paura senza mettere in dubbio il mio valore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私は自分の価値を疑うことなく、自分の恐怖を疑うことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나는 내 가치에 대해 의문을 제기하지 않고도 두려움에 의문을 제기할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik kan mijn angst in twijfel trekken zonder mijn waarde in twijfel te trekken."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posso questionar meu medo sem questionar meu valor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я могу подвергнуть сомнению свой страх, не ставя под сомнение свою ценность."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我可以质疑我的恐惧而不质疑我的价值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我可以質疑我的恐懼而不質疑我的價值。"
          }
        }
      }
    },
