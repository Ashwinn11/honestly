            "value" : "Ik erken mijn capaciteiten en laat mij er met vertrouwen door leiden."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconheço minhas habilidades e deixo que elas me guiem com confiança."
