    "My actions align with my financial aspirations." : {
      "comment" : "Affirmation library quote. Keep it personal, gentle, and natural in the translated language.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أفعالي تتوافق مع طموحاتي المالية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meine Handlungen stimmen mit meinen finanziellen Zielen überein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mis acciones se alinean con mis aspiraciones financieras."
          }
