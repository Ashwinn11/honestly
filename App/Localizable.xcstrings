        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ho capito, e questo è più che sufficiente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私は私を手に入れました、そしてそれだけで十分です。"
