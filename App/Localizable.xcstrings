    "You allow yourself to be proud of small victories.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You allow yourself to be proud of small victories."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت تسمح لنفسك أن تفخر بالانتصارات الصغيرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie erlauben sich, auf kleine Siege stolz zu sein."
