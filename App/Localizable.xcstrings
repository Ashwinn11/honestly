        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Superi i dubbi su te stesso e continui ad andare avanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは自信喪失を克服し、前進し続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 자기 의심을 극복하고 계속해서 앞으로 나아갑니다."
