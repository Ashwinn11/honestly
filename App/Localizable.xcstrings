    "You nurture gratitude to grow peace within you.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You nurture gratitude to grow peace within you."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت تنمي الامتنان لتنمية السلام بداخلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du nährst die Dankbarkeit, um den Frieden in dir wachsen zu lassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutres la gratitud para hacer crecer la paz dentro de ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous nourrissez la gratitude pour faire grandir la paix en vous."
          }
        },
        "it": {
