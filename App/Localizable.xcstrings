    "You remain mindful and fully engaged throughout your day.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You remain mindful and fully engaged throughout your day."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظل واعيًا ومنخرطًا بشكل كامل طوال يومك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie bleiben den ganzen Tag über aufmerksam und voll engagiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permaneces consciente y totalmente comprometido durante todo el día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous restez attentif et pleinement engagé tout au long de votre journée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimani consapevole e pienamente impegnato durante la giornata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは一日を通して常に注意を払い、完全に取り組んでいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 하루 종일 마음을 가다듬고 완전히 참여합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je blijft de hele dag aandachtig en volledig betrokken."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você permanece atento e totalmente engajado ao longo do dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы остаетесь внимательным и полностью вовлеченным в течение всего дня."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您一整天都保持专注并全神贯注。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您一整天都保持專注並全神貫注。"
          }
        }
      }
    },
    "Each task you complete moves you forward.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each task you complete moves you forward."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل مهمة تكملها تدفعك للأمام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede erledigte Aufgabe bringt Sie voran."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada tarea que completes te hará avanzar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque tâche que vous accomplissez vous fait avancer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni attività che completi ti fa avanzare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクを完了するたびに、あなたは前進します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신이 완료한 각 작업은 당신을 앞으로 나아가게 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke taak die u voltooit, brengt u vooruit."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada tarefa que você completa o move para frente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая выполненная задача продвигает вас вперед."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您完成的每项任务都会推动您前进。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您完成的每項任務都會推動您前進。"
          }
        }
      }
