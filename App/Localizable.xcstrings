    "I am enough, exactly as I am today.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنا كافٍ، تمامًا كما أنا اليوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bin genug, genau so, wie ich heute bin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Soy suficiente, tal como soy hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je suis assez, exactement comme je suis aujourd'hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono abbastanza, esattamente come sono oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のありのままの私で、じゅうぶん。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나는 오늘 있는 그대로 충분하다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik ben genoeg, precies zoals ik vandaag ben."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu sou suficiente, exatamente como sou hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Того, кто я есть сегодня, уже достаточно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的我，原原本本，就已足够。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的我，原原本本，就已足夠。"
          }
        }
      }
    },
    "I can be gentle with myself today.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنني أن أكون لطيفًا مع نفسي اليوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich darf heute sanft mit mir sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy puedo ser amable conmigo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd'hui, je peux me traiter avec douceur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi posso essere gentile con me."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は、自分にやさしくしていい。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 나에게 다정해도 된다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik mag vandaag zacht zijn voor mezelf."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje posso ser gentil comigo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня я могу быть бережнее к себе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天，我可以温柔地对待自己。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天，我可以溫柔地對待自己。"
          }
        }
      }
    },
    "I can slow down and still get there.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنني أن أبطئ وأصل رغم ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kann langsamer werden und trotzdem ankommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedo ir más despacio y aun así llegar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je peux ralentir et quand même arriver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posso rallentare e arrivare comunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゆっくりでも、ちゃんとたどり着ける。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "천천히 가도 나는 도착할 수 있다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik kan vertragen en er toch komen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Posso desacelerar e ainda assim chegar lá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я могу замедлиться и всё равно дойти."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "慢一点，我也能抵达。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "慢一點，我也能抵達。"
          }
        }
      }
    },
    "I can take this one breath at a time.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أستطيع أن أتجاوز هذا نفَسًا بعد نفَس."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kann das Atemzug für Atemzug angehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedo con esto, una respiración a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je peux y aller une respiration à la fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posso affrontarlo un respiro alla volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひと呼吸ずつ、進めばいい。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번에 한 호흡씩 해 나갈 수 있다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik kan dit ademhaling voor ademhaling aan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Posso lidar com isso, uma respiração de cada vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я справлюсь с этим, вдох за вдохом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我可以一次一个呼吸，慢慢来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我可以一次一個呼吸，慢慢來。"
          }
        }
      }
    },
    "I deserve the kindness I give to others.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أستحق اللطف الذي أمنحه للآخرين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich verdiene die Freundlichkeit, die ich anderen schenke."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Merezco la amabilidad que doy a los demás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je mérite la bienveillance que j'offre aux autres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Merito la gentilezza che do agli altri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人に向けるやさしさを、私も受け取っていい。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나도 내가 남에게 베푸는 친절을 받을 자격이 있다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik verdien de vriendelijkheid die ik anderen geef."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu mereço a gentileza que dou aos outros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я заслуживаю той доброты, которую дарю другим."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我也值得拥有我给予别人的那份温柔。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我也值得擁有我給予別人的那份溫柔。"
          }
        }
      }
    },
    "I don't have to earn my rest.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لستُ مضطرًا لأن أكسب حقي في الراحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich muss mir meine Ruhe nicht verdienen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tengo que ganarme el descanso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je n'ai pas à mériter mon repos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non devo guadagnarmi il riposo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "休むのに、資格はいらない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쉬기 위해 자격을 얻을 필요는 없다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik hoef mijn rust niet te verdienen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não preciso merecer o meu descanso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мне не нужно заслуживать отдых."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我不需要先证明自己，才配休息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我不需要先證明自己，才配休息。"
          }
        }
      }
    },
    "I don't have to solve everything today.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يجب أن أحل كل شيء اليوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich muss heute nicht alles lösen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tengo que resolverlo todo hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je n'ai pas à tout résoudre aujourd'hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non devo risolvere tutto oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日、すべてを解決しなくていい。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 모든 걸 해결하지 않아도 된다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik hoef vandaag niet alles op te lossen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não preciso resolver tudo hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мне не нужно решать всё сегодня."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我不必在今天解决所有事。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我不必在今天解決所有事。"
          }
        }
      }
    },
    "I trust myself to figure it out.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثق بنفسي أنني سأجد الحل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich vertraue darauf, dass ich es herausfinde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confío en mí para resolverlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je me fais confiance pour trouver la solution."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi fido di me: troverò la strada."
          }
