    "I’ve got me—and that’s more than enough." : {
      "comment" : "Affirmation library quote. Keep it personal, gentle, and natural in the translated language.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لقد حصلت علي، وهذا أكثر من كافي."
