    "What do you need to hear this morning that nobody's said yet?" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما الذي تحتاج إلى سماعه هذا الصباح ولم يقله أحد حتى الآن ؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was musst du heute Morgen hören, das noch niemand gesagt hat?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué necesitas escuchar esta mañana que nadie haya dicho todavía?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qu'avez-vous besoin d'entendre ce matin que personne n'a encore dit ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa hai bisogno di sentire stamattina che nessuno ha ancora detto?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今朝、まだ誰も言っていない何を聞く必要がありますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 아침에 아직 아무도 말하지 않았다는 것을 들어야 할 것은 무엇입니까?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat moet je vanmorgen horen dat nog niemand heeft gezegd?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que você precisa ouvir esta manhã que ninguém disse ainda?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что вам нужно услышать сегодня утром, что еще никто не сказал?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天早上你还有什么需要听的，还没有人说过？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你今天早上需要聽到甚麼還沒人說的話嗎？"
          }
        }
      }
    },
    "What do you want to leave behind this morning?" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ماذا تريد أن تترك هذا الصباح ؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was möchtest du heute Morgen zurücklassen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué quieres dejar atrás esta mañana?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que voulez-vous laisser derrière vous ce matin ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa vuoi lasciarti alle spalle stamattina?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何を残したいですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 아침에 무엇을 남기고 싶으신가요?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat wil je vanmorgen achterlaten?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que quer deixar para trás esta manhã?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что вы хотите оставить после себя этим утром?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天早上您想留下什么？"
