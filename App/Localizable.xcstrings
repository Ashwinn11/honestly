    "Every morning you've written, always here to revisit.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل صباح كتبته، دائمًا هنا لتعود إليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Morgen, den du geschrieben hast, immer hier zum Nachlesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada mañana que has escrito, siempre aquí para volver a leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque matin que tu as écrit, toujours là pour y revenir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni mattina che hai scritto, sempre qui da rivedere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書いたすべての朝が、いつでもここで読み返せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신이 쓴 모든 아침이 언제나 여기서 다시 볼 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke ochtend die je hebt geschreven, altijd hier om terug te lezen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada manhã que escreveste, sempre aqui para reler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждое написанное утро — всегда здесь, чтобы вернуться к нему."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你写下的每一个早晨，都留在这里供你重温。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你寫下的每一個早晨，都留在這裡供你重溫。"
          }
        }
      }
    },
