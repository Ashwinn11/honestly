        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天有什麼義務是真實的，你編造了哪些義務？"
          }
        }
      }
    },
    "What old story about yourself are you ready to stop believing?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما هي القصة القديمة عن نفسك التي أنت على استعداد للتوقف عن تصديقها ؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche alte Geschichte über dich selbst bist du bereit, nicht mehr zu glauben?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué vieja historia sobre ti estás listo para dejar de creer?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle vieille histoire sur vous-même êtes-vous prêt à arrêter de croire ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale vecchia storia su di te sei pronto a smettere di credere?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分自身についてのどのような古い話を信じるのをやめる準備ができていますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자신에 대한 어떤 옛날 이야기를 믿을 준비가 되었는가?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welk oud verhaal over jezelf ben je klaar om te stoppen met geloven?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em que velha história sobre si mesmo você está pronto para parar de acreditar?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В какую старую историю о себе вы готовы перестать верить?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你准备好停止相信什么关于自己的古老故事？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關於你自己的哪些舊故事，你準備好不再相信了嗎？"
          }
        }
      }
    },
    "What stays on your device": {
      "extractionState": "manual",
      "localizations": {
