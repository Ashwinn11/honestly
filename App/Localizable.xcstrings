        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무도 이것을 읽지 않을 것이라는 것을 알았다면 무엇을 쓰겠습니까?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat zou je schrijven als je wist dat niemand dit ooit zou lezen?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você escreveria se soubesse que ninguém jamais leria isso?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что бы вы написали, если бы знали, что никто никогда не прочитает это?"
