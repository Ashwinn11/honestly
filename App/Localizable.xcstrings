    "It's a really good app—it's attractive and minimalist, with no distractions, which makes it perfect for mornings." : {
      "comment" : "Faithful translation of a real App Store review, attributed in onboarding; non-English display is labeled Translated from English. Source: user-provided Desktop screenshot, 2026-10-25.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إنه تطبيق جيد حقًا؛ جميل وبسيط وخالٍ من المشتتات، مما يجعله مثاليًا للصباح."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine wirklich gute App – ansprechend und minimalistisch, ohne Ablenkungen. Perfekt für den Morgen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es una aplicación muy buena: atractiva y minimalista, sin distracciones, lo que la hace perfecta para las mañanas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est une très bonne application : agréable et minimaliste, sans distractions, donc parfaite pour le matin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È un’app davvero valida: bella e minimalista, senza distrazioni, perfetta per la mattina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本当に良いアプリです。見た目がよく、シンプルで気が散るものがないので、朝にぴったりです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정말 좋은 앱이에요. 보기 좋고 미니멀하며 방해 요소가 없어서 아침에 쓰기 딱 좋아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een heel goede app: aantrekkelijk en minimalistisch, zonder afleiding. Daardoor is hij perfect voor de ochtend."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É uma aplicação muito boa: bonita e minimalista, sem distrações, o que a torna perfeita para as manhãs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очень хорошее приложение: красивое, минималистичное, без отвлекающих деталей — идеально для утра."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这款应用真的很好看，设计简约，没有干扰，非常适合早晨使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這款 App 真的很好看，設計簡約，沒有干擾，非常適合早晨使用。"
          }
        }
      }
    },
