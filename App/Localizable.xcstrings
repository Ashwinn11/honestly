            "value" : "Ваша страсть ведет вас к величию."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的热情驱使你走向伟大。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
