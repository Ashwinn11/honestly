    "What does the most honest version of you want to say today?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ماذا تريد النسخة الأكثر صدقًا منك أن تقوله اليوم ؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was will die ehrlichste Version von dir heute sagen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué quiere decir hoy la versión más honesta de ti?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce que la version la plus honnête de vous veut dire aujourd'hui ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa vuole dire oggi la versione più onesta di te?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日、あなたが最も正直に言いたいことは何ですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 가장 솔직하게 말하고 싶은 것은 무엇인가요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat wil de eerlijkste versie van jou vandaag zeggen?"
