          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت تسمح للحظة أن تتكشف دون التسرع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie lassen zu, dass sich der Moment entfaltet, ohne sich zu beeilen."
          }
