    "You are enough — always have been, always will be." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت كافي – لقد كنت دائمًا، وستظل كذلك دائمًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist genug – warst es schon immer und wirst es immer sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are enough — always have been, always will be."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eres suficiente, siempre lo has sido y siempre lo serás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes suffisant – vous l’avez toujours été, vous le serez toujours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei abbastanza: lo sei sempre stato, lo sarai sempre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは十分です—これまでも、これからも十分です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 충분합니다. 언제나 그랬고 앞으로도 그럴 것입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jij bent genoeg – dat ben je altijd geweest en dat zal altijd zo blijven."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você é o suficiente - sempre foi, sempre será."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вас достаточно — всегда было и всегда будет."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有你就足够了——一直如此，永远如此。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有你就足夠了——一直如此，永遠如此。"
          }
        }
      }
    },
