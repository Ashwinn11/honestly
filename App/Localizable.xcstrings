    "I move when action is needed, and I pause when renewal is required." : {
      "comment" : "Affirmation library quote. Keep it personal, gentle, and natural in the translated language.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أتحرك عندما يكون هناك حاجة إلى إجراء، وأتوقف مؤقتًا عندما يكون التجديد مطلوبًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich bewege mich, wenn Handlungsbedarf besteht, und halte inne, wenn eine Erneuerung erforderlich ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me muevo cuando es necesario actuar y hago una pausa cuando es necesario renovarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bouge lorsqu'une action est nécessaire et je fais une pause lorsqu'un renouvellement est nécessaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi muovo quando è necessaria un'azione e mi fermo quando è necessario un rinnovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクションが必要な場合は移動し、更新が必要な場合は一時停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "행동이 필요할 때 움직이고, 갱신이 필요할 때 멈춥니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik beweeg wanneer actie nodig is, en ik pauzeer wanneer vernieuwing nodig is."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eu movo quando uma ação é necessária e faço uma pausa quando a renovação é necessária."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я перемещаюсь, когда необходимо действие, и делаю паузу, когда требуется обновление."
