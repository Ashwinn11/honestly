    "What would a good friend say to you about where you are right now?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ماذا سيقول لك الصديق الجيد عن مكانك الآن ؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was würde ein guter Freund zu dir sagen, wo du gerade bist?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué te diría un buen amigo sobre dónde te encuentras en este momento?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qu'un bon ami vous dirait sur l'endroit où vous êtes en ce moment ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa direbbe un buon amico di dove sei in questo momento?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが今どこにいるかについて、良い友人はあなたに何と言いますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋은 친구가 지금 당신이 있는 곳에 대해 뭐라고 말하겠는가?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat zou een goede vriend tegen je zeggen over waar je nu bent?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que um bom amigo lhe diria sobre onde você está agora?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что бы сказал вам хороший друг о том, где вы сейчас находитесь?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于您目前所处的位置，好朋友会对您说什么？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關於您目前所處的位置，好朋友會對您說什麼？"
          }
        }
      }
    },
    "What would make this morning feel like it was yours?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما الذي سيجعل هذا الصباح يبدو وكأنه كان لك ؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was würde heute Morgen das Gefühl geben, dass es deins war?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué haría que esta mañana se sintiera como si fuera tuya?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qui donnerait l'impression que ce matin était le vôtre ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa farebbe sentire questa mattina come se fosse tua?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今朝、それがあなたのものだと感じさせるものは何ですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 아침을 내 것처럼 느끼게 하는 것은 무엇일까요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat zou vanmorgen het gevoel geven dat het van jou was?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que faria esta manhã parecer que era seu?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что заставило бы это утро почувствовать, что оно ваше?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "什么会让今天早上感觉像是你的？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "什麼會讓今天早上感覺像是你的？"
          }
        }
      }
    },
    "What would you do today if you weren't afraid of getting it wrong?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ماذا ستفعل اليوم إذا لم تكن خائفًا من أن تخطئ ؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was würden Sie heute tun, wenn Sie keine Angst hätten, etwas falsch zu machen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué harías hoy si no tuvieras miedo de equivocarte?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que feriez-vous aujourd'hui si vous n'aviez pas peur de vous tromper ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa faresti oggi se non avessi paura di sbagliare?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "間違うことを恐れていなかったら、今日は何をしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오해하는 것을 두려워하지 않는다면 오늘 무엇을 하시겠습니까?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat zou je vandaag doen als je niet bang was om het verkeerd te doen?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você faria hoje se não tivesse medo de errar?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что бы вы сделали сегодня, если бы не боялись ошибиться?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你不害怕出错，你今天会怎么做？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你不害怕出錯，你今天會怎麼做？"
          }
        }
      }
    },
    "What would you tell a friend who felt exactly the way you do today?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ماذا ستقول لصديق شعر بالطريقة التي تشعر بها اليوم بالضبط ؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was würdest du einem Freund sagen, der sich genau so gefühlt hat, wie du es heute tust?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué le dirías a un amigo que se sintiera exactamente como tú lo haces hoy?"
