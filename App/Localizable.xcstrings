    "Before the world,\na moment for you.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل الانشغال بالعالم،\nلحظة لنفسك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor die Welt ruft,\nein Moment für dich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes que el mundo,\nun momento para ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant le monde,\nun instant pour vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima del mondo,\nun momento per te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "世界に向き合う前に、\n自分のためのひとときを。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세상을 마주하기 전,\n나를 위한 잠깐의 시간."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voordat de wereld roept,\neen moment voor jou."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes do mundo,\num momento para ti."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем начнётся день,\nмгновение для себя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在面对世界之前，\n留一点时间给自己。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在面對世界之前，\n留一點時間給自己。"
          }
        }
      }
    },
    "Your attention, on your terms": {
