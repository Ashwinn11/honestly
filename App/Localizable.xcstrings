    "Write today's page — a few quiet minutes, just for you.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب صفحة اليوم — بضع دقائق هادئة، لك وحدك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib deine heutige Seite — ein paar ruhige Minuten, nur für dich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe la página de hoy — unos minutos de calma, solo para ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écris ta page du jour — quelques minutes calmes, rien que pour toi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi la pagina di oggi — pochi minuti di calma, solo per te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のページを書きましょう — あなただけの静かな数分間。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 페이지를 써보세요 — 오직 당신만을 위한 조용한 몇 분."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf je pagina van vandaag — een paar rustige minuten, alleen voor jou."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreve a página de hoje — uns minutos de calma, só para ti."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напиши сегодняшнюю страницу — несколько спокойных минут только для тебя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写下今天的日记吧——只属于你的几分钟宁静。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寫下今天的日記吧——只屬於你的幾分鐘寧靜。"
          }
        }
      }
    },
    "Write your first morning page —\nit'll gather here.": {
