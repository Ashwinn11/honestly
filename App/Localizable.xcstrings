        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você supera a dúvida e segue em frente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы поднимаетесь над неуверенностью в себе и продолжаете двигаться вперед."
