    "Couldn't reach iCloud. Check you're signed in and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى iCloud. تحقّق من تسجيل دخولك وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud konnte nicht erreicht werden. Prüfe, ob du angemeldet bist, und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con iCloud. Comprueba que iniciaste sesión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre iCloud. Vérifie que tu es connecté(e) et réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere iCloud. Controlla di aver eseguito l'accesso e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudに接続できませんでした。サインインを確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에 연결할 수 없어요. 로그인 상태를 확인하고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan geen verbinding maken met iCloud. Controleer of je bent aangemeld en probeer het opnieuw."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
