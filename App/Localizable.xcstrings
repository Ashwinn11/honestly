        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mijn waarde hangt niet af van wat ik gedaan krijg."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Meu valor não se mede pelo que eu consigo fazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Моя ценность не измеряется тем, сколько я успеваю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我的价值，不由我完成了多少来衡量。"
          }
