    "I recognize my abilities and let them guide me with confidence." : {
      "comment" : "Affirmation library quote. Keep it personal, gentle, and natural in the translated language.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنا أدرك قدراتي وأسمح لهم بإرشادي بثقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich erkenne meine Fähigkeiten und lasse mich selbstbewusst von ihnen leiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconozco mis capacidades y me dejo guiar con confianza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je reconnais mes capacités et je me laisse guider en toute confiance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riconosco le mie capacità e mi lascio guidare con fiducia."
