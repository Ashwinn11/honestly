    "Pick words you need.\nSee one each day.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر الكلمات التي تحتاجها.\nتظهر لك واحدة كل يوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Worte, die dir guttun.\nJeden Tag eines davon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige las palabras que necesitas.\nVerás una cada día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les mots qu’il vous faut.\nRetrouvez-en un chaque jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli le parole che ti servono.\nNe vedrai una ogni giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今ほしい言葉を選ぼう。\n毎日ひとつ、あなたのそばに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내게 필요한 말을 골라요.\n하루에 하나씩 만나보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies woorden die je nodig hebt.\nZie er elke dag één."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe as palavras de que precisas.\nVê uma por dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите нужные вам слова.\nПо одной фразе каждый день."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选出你需要的话语。\n每天看见一句。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選出你需要的話語。\n每天看見一句。"
          }
        }
      }
    },
