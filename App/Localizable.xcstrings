    "You are not defined by your doubts—they pass.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are not defined by your doubts—they pass."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتم تحديدك من خلال شكوكك، فهي تمر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie definieren sich nicht durch Ihre Zweifel – sie gehen vorüber."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus dudas no te definen: pasan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n’êtes pas défini par vos doutes – ils passent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sei definito dai tuoi dubbi: passano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたはあなたの疑いによって定義されるのではなく、疑いは過ぎ去ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 당신의 의심으로 정의되지 않습니다. 그것은 통과합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je wordt niet gedefinieerd door je twijfels; ze gaan voorbij."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não é definido pelas suas dúvidas – elas passam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вас не определяют ваши сомнения — они проходят."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你不是由你的怀疑来定义的——它们会过去。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你不是由你的懷疑來定義的——它們會過去。"
          }
        }
      }
    },
    "You are fearless in pursuit of what sets your soul on fire.": {
      "extractionState": "manual",
