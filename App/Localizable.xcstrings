        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was möchtest du heute Morgen zurücklassen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué quieres dejar atrás esta mañana?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que voulez-vous laisser derrière vous ce matin ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa vuoi lasciarti alle spalle stamattina?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何を残したいですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 아침에 무엇을 남기고 싶으신가요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat wil je vanmorgen achterlaten?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que quer deixar para trás esta manhã?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что вы хотите оставить после себя этим утром?"
