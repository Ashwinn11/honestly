    "What's the quietest thing on your mind right now?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما هو أهدأ شيء في ذهنك الآن ؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was hast du gerade am leisesten im Kopf?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué es lo más tranquilo que tienes en mente en este momento?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle est la chose la plus silencieuse qui vous préoccupe en ce moment ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual è la cosa più tranquilla che hai in mente in questo momento?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今、一番静かに考えていることは何ですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 당신의 마음에 가장 조용한 것은 무엇입니까?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat is het stilste waar je nu aan denkt?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual é a coisa mais silenciosa em sua mente agora?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что у тебя сейчас самое тихое в голове?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
