        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは自分の人生の豊かさを認識します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 당신의 삶의 풍요로움을 인식합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je herkent de overvloed in je leven."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você reconhece a abundância em sua vida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы осознаете изобилие в своей жизни."
          }
