          "stringUnit" : {
            "state" : "translated",
            "value" : "Mes actions correspondent à mes aspirations financières."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mie azioni sono in linea con le mie aspirazioni finanziarie."
