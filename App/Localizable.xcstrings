        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我原諒自己和他人過去的痛苦。"
          }
        }
      }
    },
    "I forgive myself and others, and I am free from the weight of past relationships." : {
