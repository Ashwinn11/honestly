        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe mich – und das ist mehr als genug."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya me tengo, y eso es más que suficiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je l’ai, et c’est plus que suffisant."
