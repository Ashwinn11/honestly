        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que diriez-vous à un ami qui se sentait exactement comme vous le faites aujourd'hui ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa diresti a un amico che si sente esattamente come te oggi?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のあなたとまったく同じように感じた友人に，どのようなことを伝えますか。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 당신이 하는 것과 똑같이 느낀 친구에게 뭐라고 말하겠는가?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat zou je een vriend vertellen die zich precies zo voelde als jij vandaag?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que diria a um amigo que se sente exatamente da maneira que se sente hoje?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что бы вы сказали другу, который чувствует то же, что и вы сегодня?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你会对一个和你今天有完全相同感受的朋友说些什么？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果一位朋友對你今天的行為有完全相同的感受，你會對他說什麼？"
          }
        }
      }
    },
    "What would you write if you knew nobody would ever read this?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ماذا ستكتب إذا عرفت أن لا أحد سيقرأ هذا ؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was würden Sie schreiben, wenn Sie wüssten, dass niemand dies jemals lesen würde?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué escribirías si supieras que nadie leería esto?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que feriez-vous si vous saviez que personne ne lirait jamais cela ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
