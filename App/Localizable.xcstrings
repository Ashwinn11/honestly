        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gratidão traz alegria e luz para sua vida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Благодарность приносит радость и свет в вашу жизнь."
