          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi valor no depende de lo que los demás piensen de mí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ma valeur ne dépend pas de ce que les autres pensent de moi."
