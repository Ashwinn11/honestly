            "value": "You recognize the abundance in your life."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت تعترف بالوفرة في حياتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie erkennen die Fülle in Ihrem Leben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconoces la abundancia en tu vida."
          }
        },
