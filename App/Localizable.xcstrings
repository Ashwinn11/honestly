          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf konnte nicht abgeschlossen werden. Prüfe deine Verbindung und versuch es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar la compra. Comprueba tu conexión e inténtalo de nuevo."
