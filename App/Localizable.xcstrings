          "stringUnit" : {
            "state" : "translated",
            "value" : "나에겐 충분하다. 그것만으로도 충분하다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik heb mij – en dat is meer dan genoeg."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estou comigo - e isso é mais que suficiente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я есть — и этого более чем достаточно."
