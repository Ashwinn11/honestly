    "You are open to ease and grace in all things." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت منفتح على السهولة والنعمة في كل شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist in allen Dingen offen für Leichtigkeit und Gnade."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are open to ease and grace in all things."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás abierto a la tranquilidad y la gracia en todas las cosas."
