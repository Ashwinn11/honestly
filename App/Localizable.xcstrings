          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta toegang tot Schermtijd toe en kies de apps die je wilt pauzeren."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite o acesso ao Tempo de ecrã e escolhe as apps que queres pausar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к Экранному времени, затем выберите приложения для паузы."
