        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你会超越自我怀疑并继续前进。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你會超越自我懷疑並繼續前進。"
          }
        }
      }
    },
    "You rest in quiet confidence and gentle strength.": {
