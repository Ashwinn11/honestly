            "value": "Erlaube den Zugriff auf Bildschirmzeit und wähle dann die Apps, die warten sollen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a Tiempo de uso y elige las apps que quieres pausar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès à Temps d’écran, puis choisissez les apps à mettre en pause."
