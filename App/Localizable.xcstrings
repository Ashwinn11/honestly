    "A few honest lines are enough.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بضعة أسطر صادقة تكفي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein paar ehrliche Zeilen genügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bastan unas líneas sinceras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelques lignes sincères suffisent."
          }
        },
        "it": {
