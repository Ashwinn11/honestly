    "You are healing and that makes you strong.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are healing and that makes you strong."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت تشفى وهذا يجعلك قوياً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du heilst und das macht dich stark."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás sanando y eso te hace fuerte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous guérissez et cela vous rend fort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai guarendo e questo ti rende forte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは治癒しており、それがあなたを強くします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 치유되고 있으며 그것이 당신을 강하게 만듭니다."
