        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que a sua versão mais honesta quer dizer hoje?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что вы хотите сказать сегодня самой честной версией?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您今天最诚实的说法是什么？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你今天想說什麼最誠實的話？"
          }
        }
      }
    },
    "What does your body feel like before the day has an opinion?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كيف يشعر جسمك قبل أن يكون لليوم رأي ؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie fühlt sich Ihr Körper an, bevor der Tag eine Meinung hat?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cómo se siente tu cuerpo antes de que el día tenga una opinión?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce que votre corps ressent avant que la journée n'ait une opinion ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come si sente il tuo corpo prima che il giorno abbia un'opinione?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その日が来る前に、あなたの体はどのように感じますか？"
