      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You give yourself permission to rise."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت تعطي لنفسك الإذن بالارتفاع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du gibst dir selbst die Erlaubnis aufzustehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te das permiso para levantarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous vous donnez la permission de vous lever."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti dai il permesso di alzarti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは自分自身に立ち上がる許可を与えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 자신에게 일어날 수 있는 권한을 부여합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je geeft jezelf toestemming om op te staan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você se dá permissão para subir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы даете себе разрешение подняться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你允许自己站起来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你允許自己站起來。"
          }
        }
      }
    },
    "You recognize the abundance in your life.": {
      "extractionState": "manual",
      "localizations": {
