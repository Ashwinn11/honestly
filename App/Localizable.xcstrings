          "stringUnit": {
            "state": "translated",
            "value": "你今天需要在哪裡畫一條線？"
          }
        }
      }
    },
    "Where's your head this morning, honestly?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أين رأسك هذا الصباح، بصدق ؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo ist dein Kopf heute Morgen, ehrlich gesagt?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Dónde está tu cabeza esta mañana, sinceramente?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où est ta tête ce matin, honnêtement ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dov'è la tua testa stamattina, onestamente?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正直、今朝はどこに行ったんだ？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "솔직히 오늘 아침 머리는 어딨어?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waar is je hoofd vanmorgen, eerlijk gezegd?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde está a sua cabeça esta manhã, honestamente?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Честно говоря, где твоя голова сегодня утром?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "老实说，今天早上你的头在哪里？"
