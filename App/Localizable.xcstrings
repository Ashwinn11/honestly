    "I accept responsibility for what is mine and release what is not." : {
      "comment" : "Affirmation library quote. Keep it personal, gentle, and natural in the translated language.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أقبل المسؤولية عما هو لي وأطلق سراح ما ليس لي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich übernehme die Verantwortung für das, was mir gehört, und gebe frei, was nicht mir gehört."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acepto la responsabilidad de lo que es mío y libero lo que no es."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J'accepte la responsabilité de ce qui m'appartient et je libère ce qui ne m'appartient pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accetto la responsabilità di ciò che è mio e rilascio ciò che non lo è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私は自分のものに対する責任を受け入れ、そうでないものを手放します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 것에는 책임을 지고, 내 것이 아닌 것은 놓아준다."
