    "I forgive myself and others for past pain." : {
      "comment" : "Affirmation library quote. Keep it personal, gentle, and natural in the translated language.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أسامح نفسي والآخرين على آلام الماضي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich vergebe mir und anderen den vergangenen Schmerz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me perdono a mí mismo y a los demás por dolores pasados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je me pardonne, ainsi qu'aux autres, les douleurs passées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perdono me stesso e gli altri per il dolore passato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私は自分自身と他人の過去の痛みを許します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나는 과거의 고통에 대해 나 자신과 다른 사람들을 용서합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik vergeef mezelf en anderen voor pijn uit het verleden."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eu perdôo a mim mesmo e aos outros pelas dores do passado."
