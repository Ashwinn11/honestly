        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의견이 있기 전의 당신의 몸은 어떤 느낌인가요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe voelt je lichaam voordat de dag een mening heeft?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Como é a sensação do seu corpo antes do dia ter uma opinião?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как чувствует себя ваше тело до того, как день выскажет свое мнение?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在白天之前，您的身体感觉如何？"
