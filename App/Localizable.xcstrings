    "The first few minutes of your day, finally yours.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أول دقائق يومك، أخيرًا لك أنت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ersten Minuten deines Tages, endlich ganz dir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los primeros minutos de tu día, por fin tuyos."
          }
        },
        "fr": {
