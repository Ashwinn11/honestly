    "It's a really good app—it's attractive and minimalist, with no distractions, which makes it perfect for mornings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنه تطبيق جيد حقًا؛ جميل وبسيط وخالٍ من المشتتات، مما يجعله مثاليًا للصباح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine wirklich gute App – ansprechend und minimalistisch, ohne Ablenkungen. Perfekt für den Morgen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es una aplicación muy buena: atractiva y minimalista, sin distracciones, lo que la hace perfecta para las mañanas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est une très bonne application : agréable et minimaliste, sans distractions, donc parfaite pour le matin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È un’app davvero valida: bella e minimalista, senza distrazioni, perfetta per la mattina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本当に良いアプリです。見た目がよく、シンプルで気が散るものがないので、朝にぴったりです。"
          }
        },
        "ko": {
