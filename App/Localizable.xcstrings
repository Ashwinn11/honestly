            "value": "私なら、きっと答えを見つけられる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나는 스스로 답을 찾아낼 거라고 믿는다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik vertrouw erop dat ik het uitzoek."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Confio em mim para encontrar a saída."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я верю, что разберусь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我相信自己能想出办法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我相信自己能想出辦法。"
          }
        }
      }
    },
    "I'll show up for myself before anyone else.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سأكون حاضرًا لنفسي قبل أي أحد آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bin zuerst für mich selbst da."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero estaré para mí, antes que para nadie más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je serai là pour moi avant d'être là pour les autres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci sarò per me, prima che per chiunque altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰よりも先に、自分のためにここにいる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누구보다 먼저 나 자신을 챙기겠다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik ben er eerst voor mezelf, vóór iemand anders."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vou estar presente para mim antes de qualquer outra pessoa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде всего я позабочусь о себе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在照顾任何人之前，我先照顾好自己。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在照顧任何人之前，我先照顧好自己。"
          }
        }
      }
    },
    "I'm allowed to take up space.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من حقي أن يكون لي مكان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich darf Raum einnehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tengo derecho a ocupar mi espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai le droit de prendre de la place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho il diritto di occupare spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私は、ここにいていい。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나는 내 자리를 차지해도 괜찮다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik mag ruimte innemen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu tenho o direito de ocupar espaço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я имею право занимать своё место."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我有权利占据属于我的空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我有權利佔據屬於我的空間。"
          }
        }
      }
    },
    "I'm becoming someone I'm proud of.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصبح شخصًا أفخر به."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich werde jemand, auf den ich stolz bin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me estoy convirtiendo en alguien que me enorgullece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je deviens quelqu'un dont je peux être fier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sto diventando una persona di cui vado fiero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私は、誇れる自分になっていく。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나는 스스로 자랑스러운 사람이 되어 가고 있다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik word iemand op wie ik trots ben."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estou me tornando alguém de quem me orgulho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я становлюсь человеком, которым горжусь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我正在成为让自己骄傲的人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我正在成為讓自己驕傲的人。"
          }
        }
      }
    },
    "I'm doing my best, and that counts.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبذل ما بوسعي، وهذا له قيمته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich gebe mein Bestes, und das zählt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estoy haciendo lo mejor que puedo, y eso cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je fais de mon mieux, et ça compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sto facendo del mio meglio, e conta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私はベストを尽くしている。それには意味がある。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나는 최선을 다하고 있고, 그걸로 충분하다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik doe mijn best, en dat telt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estou fazendo o meu melhor, e isso conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я делаю всё, что могу, и это важно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我在尽力，这就算数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我在盡力，這就算數。"
          }
        }
      }
    },
    "I'm grateful for this quiet morning.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنا ممتن لهذا الصباح الهادئ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bin dankbar für diesen ruhigen Morgen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agradezco esta mañana tranquila."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'accueille ce matin calme avec gratitude."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Provo gratitudine per questa mattina tranquilla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この静かな朝に、感謝。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 고요한 아침에 감사한다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik ben dankbaar voor deze rustige ochtend."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agradeço por esta manhã tranquila."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я ценю это тихое утро."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我感谢这个安静的早晨。"
